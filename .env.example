# Agent Web UI Configuration

# Authentication (username and password)
# Set username and password to enable authentication. If left empty, authentication will be disabled.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Secret key for session cookie signing (optional, auto-generated if left empty)
AUTH_SECRET_KEY=

# Secret key for sha256 signing of public file links
# If left empty, uses AUTH_SECRET_KEY or is auto-generated
PUBLIC_LINK_SECRET=

# Base directory for workspaces
WORKSPACE_BASE=/workspaces

# Path to agent binary and launch arguments
AGENT_BIN=/usr/local/bin/agent
AGENT_ARGS=--dangerously-skip-permissions
